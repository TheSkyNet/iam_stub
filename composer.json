{
    "name": "iam-lab/phalcon-stub",
    "description": "A clean, minimal Phalcon PHP framework stub project for generating new PHfalcon and Miral projects",
    "type": "project",
    "keywords": [
        "phalcon",
        "php",
        "framework",
        "stub",
        "template",
        "skeleton",
        "starter"
    ],
    "homepage": "https://github.com/iam-lab/phalcon-stub",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "license": "MIT",
    "authors": [
        {
            "name": "Kev Morton",
            "email": "kev@kevs.biz"
        }
    ],
    "config": {
        "secure-http": true,
        "github-protocols": [
            "https"
        ],
        "preferred-install": "dist"
    },
    "require": {
        "php": "^8.5",
        "ext-curl": "*",
        "ext-gd": "*",
        "ext-pdo": "*",
        "ext-phalcon": "^5.23",
        "ext-redis": "*",
        "ext-sodium": "*",
        "cboden/ratchet": "^0.4.4",
        "defuse/php-encryption": "^2.4",
        "endroid/qr-code": "^6.1",
        "filp/whoops": "^2.18",
        "firebase/php-jwt": "^7.2",
        "league/flysystem": "^3.36",
        "marc-mabe/php-enum": "^4.7.2",
        "nesbot/carbon": "^3.15",
        "phalcon/migrations": "^3.0",
        "pusher/pusher-php-server": "^7.3",
        "symfony/finder": "^8.1",
        "symfony/var-dumper": "^8.1"
    },
    "autoload": {
        "psr-4": {
            "IamLab\\": "IamLab/"
        },
        "files": [
            "IamLab/Core/Helpers/include.php"
        ]
    },
    "require-dev": {
        "phalcon/ide-stubs": "^5.23",
        "phpunit/phpunit": "^13.4",
        "rector/rector": "^2.7",
        "roave/security-advisories": "dev-latest",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "scripts": {
        "post-create-project-cmd": [
            "@php -r \"copy('.env.example', '.env');\"",
            "@php -r \"echo '\\n\ud83d\ude80 Phalcon Stub Project Created Successfully!\\n';\"",
            "@php -r \"echo '\\nNext steps:\\n';\"",
            "@php -r \"echo '1. Update .env file with your configuration\\n';\"",
            "@php -r \"echo '2. Run: ./phalcons up -d\\n';\"",
            "@php -r \"echo '3. Run: ./phalcons migrate\\n';\"",
            "@php -r \"echo '4. Visit: http://localhost:8080\\n';\"",
            "@php -r \"echo '\\nFor more information, see README.md\\n\\n';\""
        ],
        "rector": "vendor/bin/rector",
        "rector:dry": "vendor/bin/rector process --dry-run --ansi",
        "rector:apply": "vendor/bin/rector process --ansi"
    }
}
