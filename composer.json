{
    "name": "iam-lab/phalcon-stub",
    "description": "A clean, minimal Phalcon PHP framework stub project for generating new PHfalcon and Miral projects",
    "type": "project",
    "keywords": [
        "phalcon",
        "php",
        "framework",
        "stub",
        "template",
        "skeleton",
        "starter"
    ],
    "homepage": "https://github.com/TheSkyNet/iam_stub",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "license": "MIT",
    "authors": [
        {
            "name": "Kev Morton",
            "email": "kev@kevs.biz"
        }
    ],
    "config": {
        "secure-http": true,
        "github-protocols": [
            "https"
        ],
        "preferred-install": "dist"
    },
    "require": {
        "php": "^8.5",
        "ext-curl": "*",
        "ext-gd": "*",
        "ext-pdo": "*",
        "ext-phalcon": "^5.23",
        "ext-redis": "*",
        "ext-sodium": "*",
        "cboden/ratchet": "^0.4.4",
        "defuse/php-encryption": "^2.4",
        "endroid/qr-code": "^6.1",
        "filp/whoops": "^2.18",
        "firebase/php-jwt": "^7.2",
        "league/flysystem": "^3.36",
        "marc-mabe/php-enum": "^4.7.2",
        "nesbot/carbon": "^3.15",
        "phalcon/migrations": "^3.0",
        "pusher/pusher-php-server": "^7.3",
        "symfony/finder": "^8.1",
        "symfony/var-dumper": "^8.1"
    },
    "autoload": {
        "psr-4": {
            "IamLab\\": "IamLab/"
        },
        "files": [
            "IamLab/Core/Helpers/include.php"
        ]
    },
    "require-dev": {
        "phalcon/ide-stubs": "^5.23",
        "phpunit/phpunit": "^13.4",
        "rector/rector": "^2.7",
        "roave/security-advisories": "dev-latest",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "scripts": {
        "post-create-project-cmd": [
            "@php -r \"if (!file_exists('.env') && file_exists('.env.example')) { copy('.env.example', '.env'); }\"",
            "@php -r \"echo PHP_EOL, '🚀 Phalcon Stub Project Created Successfully!', PHP_EOL;\"",
            "@php -r \"echo PHP_EOL, 'Next steps:', PHP_EOL;\"",
            "@php -r \"echo '1. Update .env with your configuration', PHP_EOL;\"",
            "@php -r \"echo '2. Run: ./phalcons up -d', PHP_EOL;\"",
            "@php -r \"echo '3. Run: ./phalcons composer install', PHP_EOL;\"",
            "@php -r \"echo '4. Run: ./phalcons npm ci', PHP_EOL;\"",
            "@php -r \"echo '5. Optional: ./phalcons project:init <name> <namespace> --force', PHP_EOL;\"",
            "@php -r \"echo '6. If project:init was run: ./phalcons composer dump-autoload', PHP_EOL;\"",
            "@php -r \"echo '7. Run: ./phalcons migrate', PHP_EOL;\"",
            "@php -r \"echo '8. Optional admin: ./phalcons migrate:seed --email=admin@example.com --password=YourSecurePassword123!', PHP_EOL;\"",
            "@php -r \"echo '9. Run: ./phalcons npm run dev', PHP_EOL;\"",
            "@php -r \"echo '10. Visit: http://localhost:8085', PHP_EOL;\"",
            "@php -r \"echo PHP_EOL, 'For more information, see README.md', PHP_EOL, PHP_EOL;\""
        ],
        "rector": "vendor/bin/rector",
        "rector:dry": "vendor/bin/rector process --dry-run --ansi",
        "rector:apply": "vendor/bin/rector process --ansi"
    }
}
